@prefix aiao: <http://w3id.org/aiao#> .
@prefix claimont: <http://w3id.org/claimont#> .
@prefix data: <https://jellyfiiish.xyz/ns/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix impactont: <http://w3id.org/impactont#> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-cs: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2flutter/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2flutter.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:PddWorkflowUiShapes a owl:Ontology ;
    dcterms:title "NIAS PDD workflow shape2flutter UI shapes"@en ;
    dcterms:description "Flattened UI-facing SHACL views for PDD creation and validation forms. Canonical validation constraints remain in dataRequirements/*.ttl."@en ;
    owl:imports nias-ui:CommonUiShapes .

nias-ui:PddSectionAReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionAReport ;
    sh:property [
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reporting agent IRI" ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path claimont:hasSubject ;
        sh:node nias-ui:ProjectDesignUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Project design" ;
        ui:widget ui:subform ;
        ui:order 2 ;
    ] .

nias-ui:PddSectionBReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionBReport ;
    sh:property [
        sh:path nias-o:hasDeclaredImpact ;
        sh:node nias-ui:ImpactRequirementUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "Declared impacts" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:impactClaim ;
        sh:node nias-ui:ImpactClaimUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "Impact claims" ;
        ui:widget ui:subform ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:usesMethodology ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 99 ;
        ui:label "Report methodology IRIs" ;
        ui:widget ui:chips ;
        ui:order 3 ;
    ] .

nias-ui:PddSectionAUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property [
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionAReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "PDD Section A content" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] .

nias-ui:PddSectionBUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property [
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionBReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "PDD Section B content" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] .

nias-ui:PddSectionCUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionCStakeholderEngagement ;
    sh:property [
        sh:path nias-o:stakeholderEngagementModalities ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Stakeholder engagement modalities" ;
        ui:widget ui:textarea ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:stakeholderCommentSummary ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        ui:label "Stakeholder comment summary" ;
        ui:widget ui:textarea ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:stakeholderCommentConsideration ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        ui:label "Stakeholder comment consideration" ;
        ui:widget ui:textarea ;
        ui:order 3 ;
    ] .

nias-ui:PddCertificateIssuanceRequestUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddCertificateIssuanceRequest ;
    sh:property [
        sh:path nias-o:pddSectionAValidationReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Approved PDD-A validation review" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:pddSectionBValidationReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Approved PDD-B validation review" ;
        ui:widget ui:subform ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:pddSectionCValidationReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Approved PDD-C validation review" ;
        ui:widget ui:subform ;
        ui:order 3 ;
    ] ;
    sh:property [
        sh:path nias-o:pddSectionQualitativeReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Approved section-level qualitative review" ;
        ui:widget ui:subform ;
        ui:order 4 ;
    ] ;
    sh:property [
        sh:path nias-o:pddDocumentLevelQualitativeReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Approved document-level qualitative review" ;
        ui:widget ui:subform ;
        ui:order 5 ;
    ] ;
    sh:property [
        sh:path nias-o:requestedIssuanceAccountId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Issuance account ID" ;
        ui:help "Hedera account in shard.realm.num format." ;
        ui:order 6 ;
    ] .

nias-ui:ReviewTargetUiShape a sh:NodeShape ;
    sh:targetClass nias-o:ReviewTarget ;
    sh:property [
        sh:path nias-o:reviewedArtifact ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reviewed artifact IRI" ;
        ui:help "IRI of the exact PDD, monitoring report, or other reviewed artifact version." ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:reviewedAnchor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reviewed anchor IRI" ;
        ui:help "IRI of the concrete artifact anchor being reviewed." ;
        ui:order 2 ;
    ] .

nias-ui:DocumentFieldReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:DocumentFieldReview ;
    sh:property [
        sh:path nias-o:fieldTitle ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Field title" ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:fieldPrompt ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Field prompt" ;
        ui:widget ui:textarea ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:originalResponse ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Original response" ;
        ui:widget ui:textarea ;
        ui:order 3 ;
    ] ;
    sh:property [
        sh:path nias-o:reviewerDecision ;
        sh:in (
            nias-cs:review-reject
            nias-cs:review-corrective-action-request
            nias-cs:review-forward-action-request
            nias-cs:review-approve
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reviewer decision" ;
        ui:widget ui:radio ;
        ui:order 4 ;
    ] ;
    sh:property [
        sh:path nias-o:reviewerFeedback ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reviewer feedback" ;
        ui:widget ui:textarea ;
        ui:order 5 ;
    ] .

nias-ui:PddSectionAValidationReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GenericDocumentReview ;
    sh:property [
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "PDD-A field reviews" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Final PDD-A review decision" ;
        ui:widget ui:radio ;
        ui:order 2 ;
    ] .

nias-ui:PddSectionBValidationReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GenericDocumentReview ;
    sh:property [
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "PDD-B field reviews" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Final PDD-B review decision" ;
        ui:widget ui:radio ;
        ui:order 2 ;
    ] .

nias-ui:PddSectionCValidationReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GenericDocumentReview ;
    sh:property [
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "PDD-C field reviews" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Final PDD-C review decision" ;
        ui:widget ui:radio ;
        ui:order 2 ;
    ] .

nias-ui:GlobalQualitativeDocumentReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GlobalQualitativeDocumentReview ;
    sh:property [
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Global qualitative review workflow submission" ;
        ui:widget ui:subform ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:isReviewOf ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reviewed artifact document" ;
        ui:widget ui:text ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "Anchor-level review findings" ;
        ui:widget ui:subform ;
        ui:order 3 ;
    ] ;
    sh:property [
        sh:path nias-o:sectionQualitativeJudgement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Section-level qualitative judgement" ;
        ui:widget ui:textarea ;
        ui:order 4 ;
    ] ;
    sh:property [
        sh:path nias-o:documentLevelQualitativeJudgement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document-level qualitative judgement" ;
        ui:widget ui:textarea ;
        ui:order 5 ;
    ] ;
    sh:property [
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Final global qualitative review decision" ;
        ui:widget ui:radio ;
        ui:order 6 ;
    ] .
