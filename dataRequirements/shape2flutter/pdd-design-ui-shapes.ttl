@prefix aiao: <http://w3id.org/aiao#> .
@prefix claimont: <http://w3id.org/claimont#> .
@prefix data: <https://jellyfiiish.xyz/ns/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix impactont: <http://w3id.org/impactont#> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-cs: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2flutter/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2flutter.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:PddDesignUiShapes a owl:Ontology ;
    dcterms:title "NIAS PDD Design shape2flutter UI shapes"@en ;
    dcterms:description "Flattened UI-facing SHACL views for developer-side PDD-A, PDD-B, and PDD-C capture forms. Canonical validation constraints remain in dataRequirements/*.ttl."@en ;
    owl:imports nias-ui:CommonUiShapes .

nias-ui:PddSectionAReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionAReport ;
    sh:property [
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reporting agent IRI" ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path claimont:hasSubject ;
        sh:node nias-ui:ProjectDesignUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Project design" ;
        ui:widget ui:subform ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document schema IRI" ;
        ui:order 3 ;
    ] .

nias-ui:PddSectionBReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionBReport ;
    sh:property [
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reporting agent IRI" ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path claimont:hasSubject ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Project subject IRI" ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:hasDeclaredImpact ;
        sh:node nias-ui:ImpactRequirementUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "Declared impacts" ;
        ui:widget ui:subform ;
        ui:order 3 ;
    ] ;
    sh:property [
        sh:path nias-o:impactClaim ;
        sh:node nias-ui:ImpactClaimUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 ;
        ui:label "Impact claims" ;
        ui:widget ui:subform ;
        ui:order 4 ;
    ] ;
    sh:property [
        sh:path nias-o:usesMethodology ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 99 ;
        ui:label "Report methodology IRIs" ;
        ui:widget ui:chips ;
        ui:order 5 ;
    ] ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document schema IRI" ;
        ui:order 6 ;
    ] .

nias-ui:PddSectionAUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property [
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document IPFS URI" ;
        ui:widget ui:ipfs ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:documentSchema ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document schema IRI" ;
        ui:order 2 ;
    ] ;
    sh:property [
        sh:path nias-o:isEncrypted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Encrypted" ;
        ui:widget ui:switch ;
        ui:order 3 ;
    ] ;
    sh:property [
        sh:path nias-o:documentAuthor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document author" ;
        ui:order 4 ;
    ] ;
    sh:property [
        sh:path nias-o:authProof ;
        sh:in ( nias-cs:none nias-cs:eddsa-signature nias-cs:rsa-signature nias-cs:vc ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Authenticity proof" ;
        ui:widget ui:select ;
        ui:order 5 ;
    ] ;
    sh:property [
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionAReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "PDD Section A content" ;
        ui:widget ui:subform ;
        ui:order 6 ;
    ] ;
    sh:property [
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Workflow submission" ;
        ui:widget ui:subform ;
        ui:order 7 ;
    ] .

nias-ui:PddSectionBUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property [
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
