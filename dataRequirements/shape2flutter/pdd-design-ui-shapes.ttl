    ] ;
    sh:property [
        sh:path nias-o:stakeholderEngagementModalities ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Stakeholder engagement modalities" ;
        ui:widget ui:textarea ;
        ui:order 10 ;
    ] ;
    sh:property [
        sh:path nias-o:stakeholderCommentSummary ;
