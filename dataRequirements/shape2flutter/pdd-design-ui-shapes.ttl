        ui:label "PDD Section B content" ;
        ui:widget ui:subform ;
        ui:order 6 ;
    ] ;
    sh:property [
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Workflow submission" ;
        ui:widget ui:subform ;
        ui:order 7 ;
    ] .

nias-ui:PddSectionCUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionCStakeholderEngagement ;
    sh:property [
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document IPFS URI" ;
        ui:widget ui:ipfs ;
        ui:order 1 ;
    ] ;
    sh:property [
        sh:path nias-o:documentSchema ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
