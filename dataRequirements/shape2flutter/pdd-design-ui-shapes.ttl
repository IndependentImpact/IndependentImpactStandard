    ] ;
    sh:property [
        sh:path nias-o:isEncrypted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Encrypted" ;
        ui:widget ui:switch ;
        ui:order 3 ;
    ] ;
    sh:property [
        sh:path nias-o:documentAuthor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Document author" ;
        ui:order 4 ;
    ] ;
    sh:property [
        sh:path nias-o:authProof ;
        sh:in ( nias-cs:none nias-cs:eddsa-signature nias-cs:rsa-signature nias-cs:vc ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Authenticity proof" ;
        ui:widget ui:select ;
        ui:order 5 ;
    ] ;
    sh:property [
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        ui:label "Reporting agent IRI" ;
        ui:order 6 ;
    ] ;
    sh:property [
        sh:path claimont:hasSubject ;
        sh:datatype xsd:anyURI ;
