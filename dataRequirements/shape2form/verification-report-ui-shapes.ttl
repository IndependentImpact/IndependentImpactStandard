@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-cs: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2form/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2form.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:VerificationReportUiShapes a owl:Ontology ;
    dcterms:title "NIAS verification report shape2form UI shapes"@en ;
    dcterms:description "Flattened UI-facing SHACL views for shape2form generation for verification report workflows. Canonical constraints remain in dataRequirements/*.ttl."@en ;
    owl:imports nias-ui:CommonUiShapes .

nias-ui:ReviewTargetUiShape a sh:NodeShape ;
    sh:targetClass nias-o:ReviewTarget ;
    sh:property nias-ui:ReviewTargetUiShape-reviewedArtifact ;
    sh:property nias-ui:ReviewTargetUiShape-reviewedAnchor .

nias-ui:ReviewTargetUiShape-reviewedArtifact a sh:PropertyShape ;
        sh:path nias-o:reviewedArtifact ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ReviewTargetUiShape-reviewedAnchor a sh:PropertyShape ;
        sh:path nias-o:reviewedAnchor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:DocumentFieldReview ;
    sh:property nias-ui:DocumentFieldReviewUiShape-reviewTarget ;
    sh:property nias-ui:DocumentFieldReviewUiShape-fieldTitle ;
    sh:property nias-ui:DocumentFieldReviewUiShape-fieldPrompt ;
    sh:property nias-ui:DocumentFieldReviewUiShape-originalResponse ;
    sh:property nias-ui:DocumentFieldReviewUiShape-reviewerDecision ;
    sh:property nias-ui:DocumentFieldReviewUiShape-reviewerFeedback .

nias-ui:DocumentFieldReviewUiShape-reviewTarget a sh:PropertyShape ;
        sh:path nias-o:reviewTarget ;
        sh:node nias-ui:ReviewTargetUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-fieldTitle a sh:PropertyShape ;
        sh:path nias-o:fieldTitle ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-fieldPrompt a sh:PropertyShape ;
        sh:path nias-o:fieldPrompt ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-originalResponse a sh:PropertyShape ;
        sh:path nias-o:originalResponse ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-reviewerDecision a sh:PropertyShape ;
        sh:path nias-o:reviewerDecision ;
        sh:in (
            nias-cs:review-approve
            nias-cs:review-forward-action-request
            nias-cs:review-corrective-action-request
            nias-cs:review-reject
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-reviewerFeedback a sh:PropertyShape ;
        sh:path nias-o:reviewerFeedback ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:VerifiedImpactCertificateIssuanceRequestReview ;
    sh:property nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-hasWorkflowSubmission ;
    sh:property nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-documentLevelQualitativeJudgement ;
    sh:property nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-fieldReview ;
    sh:property nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-finalReviewDecision ;
    sh:property nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-requestedIssuanceAccountId .

nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-hasWorkflowSubmission a sh:PropertyShape ;
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-documentLevelQualitativeJudgement a sh:PropertyShape ;
        sh:path nias-o:documentLevelQualitativeJudgement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-fieldReview a sh:PropertyShape ;
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-finalReviewDecision a sh:PropertyShape ;
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-approve nias-cs:review-reject ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:VerifiedImpactCertificateIssuanceRequestReviewUiShape-requestedIssuanceAccountId a sh:PropertyShape ;
        sh:path nias-o:requestedIssuanceAccountId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .
