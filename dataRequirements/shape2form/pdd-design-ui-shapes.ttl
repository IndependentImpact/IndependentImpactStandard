        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape-documentSchema a sh:PropertyShape ;
        sh:path nias-o:documentSchema ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape-isEncrypted a sh:PropertyShape ;
        sh:path nias-o:isEncrypted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape-documentAuthor a sh:PropertyShape ;
        sh:path nias-o:documentAuthor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape-authProof a sh:PropertyShape ;
        sh:path nias-o:authProof ;
        sh:in ( nias-cs:none nias-cs:eddsa-signature nias-cs:rsa-signature nias-cs:vc ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape-reportContent a sh:PropertyShape ;
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionBReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape-hasWorkflowSubmission a sh:PropertyShape ;
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionCUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionCStakeholderEngagement ;
    sh:property nias-ui:PddSectionCUiShape-resourceIpfsUri ;
    sh:property nias-ui:PddSectionCUiShape-documentSchema ;
