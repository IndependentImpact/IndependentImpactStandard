@prefix aiao: <http://w3id.org/aiao#> .
@prefix claimont: <http://w3id.org/claimont#> .
@prefix data: <https://jellyfiiish.xyz/ns/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix impactont: <http://w3id.org/impactont#> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-cs: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2form/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2form.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:PddDesignUiShapes a owl:Ontology ;
    dcterms:title "NIAS PDD Design shape2form UI shapes"@en ;
    dcterms:description "Flattened UI-facing SHACL views for developer-side PDD-A, PDD-B, and PDD-C capture forms. Canonical validation constraints remain in dataRequirements/*.ttl."@en ;
    owl:imports nias-ui:CommonUiShapes .

nias-ui:PddSectionAReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionAReport ;
    sh:property nias-ui:PddSectionAReportContentUiShape-isMadeBy ;
    sh:property nias-ui:PddSectionAReportContentUiShape-hasSubject ;
    sh:property nias-ui:PddSectionAReportContentUiShape-conformsTo .

nias-ui:PddSectionAReportContentUiShape-isMadeBy a sh:PropertyShape ;
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAReportContentUiShape-hasSubject a sh:PropertyShape ;
        sh:path claimont:hasSubject ;
        sh:node nias-ui:ProjectDesignUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAReportContentUiShape-conformsTo a sh:PropertyShape ;
        sh:path dcterms:conformsTo ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionBReport ;
    sh:property nias-ui:PddSectionBReportContentUiShape-isMadeBy ;
    sh:property nias-ui:PddSectionBReportContentUiShape-hasSubject ;
    sh:property nias-ui:PddSectionBReportContentUiShape-hasDeclaredImpact ;
    sh:property nias-ui:PddSectionBReportContentUiShape-impactClaim ;
    sh:property nias-ui:PddSectionBReportContentUiShape-usesMethodology ;
    sh:property nias-ui:PddSectionBReportContentUiShape-conformsTo .

nias-ui:PddSectionBReportContentUiShape-isMadeBy a sh:PropertyShape ;
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBReportContentUiShape-hasSubject a sh:PropertyShape ;
        sh:path claimont:hasSubject ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBReportContentUiShape-hasDeclaredImpact a sh:PropertyShape ;
        sh:path nias-o:hasDeclaredImpact ;
        sh:node nias-ui:ImpactRequirementUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionBReportContentUiShape-impactClaim a sh:PropertyShape ;
        sh:path nias-o:impactClaim ;
        sh:node nias-ui:ImpactClaimUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionBReportContentUiShape-usesMethodology a sh:PropertyShape ;
        sh:path nias-o:usesMethodology ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 99 .

nias-ui:PddSectionBReportContentUiShape-conformsTo a sh:PropertyShape ;
        sh:path dcterms:conformsTo ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property nias-ui:PddSectionAUiShape-resourceIpfsUri ;
    sh:property nias-ui:PddSectionAUiShape-documentSchema ;
    sh:property nias-ui:PddSectionAUiShape-isEncrypted ;
    sh:property nias-ui:PddSectionAUiShape-documentAuthor ;
    sh:property nias-ui:PddSectionAUiShape-authProof ;
    sh:property nias-ui:PddSectionAUiShape-reportContent ;
    sh:property nias-ui:PddSectionAUiShape-hasWorkflowSubmission .

nias-ui:PddSectionAUiShape-resourceIpfsUri a sh:PropertyShape ;
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape-documentSchema a sh:PropertyShape ;
        sh:path nias-o:documentSchema ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape-isEncrypted a sh:PropertyShape ;
        sh:path nias-o:isEncrypted ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape-documentAuthor a sh:PropertyShape ;
        sh:path nias-o:documentAuthor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape-authProof a sh:PropertyShape ;
        sh:path nias-o:authProof ;
        sh:in ( nias-cs:none nias-cs:eddsa-signature nias-cs:rsa-signature nias-cs:vc ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape-reportContent a sh:PropertyShape ;
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionAReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAUiShape-hasWorkflowSubmission a sh:PropertyShape ;
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property nias-ui:PddSectionBUiShape-resourceIpfsUri ;
    sh:property nias-ui:PddSectionBUiShape-documentSchema ;
    sh:property nias-ui:PddSectionBUiShape-isEncrypted ;
    sh:property nias-ui:PddSectionBUiShape-documentAuthor ;
    sh:property nias-ui:PddSectionBUiShape-authProof ;
    sh:property nias-ui:PddSectionBUiShape-reportContent ;
    sh:property nias-ui:PddSectionBUiShape-hasWorkflowSubmission .

nias-ui:PddSectionBUiShape-resourceIpfsUri a sh:PropertyShape ;
