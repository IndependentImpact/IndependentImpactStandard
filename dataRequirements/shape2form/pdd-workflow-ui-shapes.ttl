@prefix aiao: <http://w3id.org/aiao#> .
@prefix claimont: <http://w3id.org/claimont#> .
@prefix data: <https://jellyfiiish.xyz/ns/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix impactont: <http://w3id.org/impactont#> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-cs: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2form/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2form.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:PddWorkflowUiShapes a owl:Ontology ;
    dcterms:title "NIAS PDD workflow shape2form UI shapes"@en ;
    dcterms:description "Flattened UI-facing SHACL views for PDD creation and validation forms. Canonical validation constraints remain in dataRequirements/*.ttl."@en ;
    owl:imports nias-ui:CommonUiShapes .

nias-ui:PddSectionAReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionAReport ;
    sh:property nias-ui:PddSectionAReportContentUiShape-isMadeBy ;
    sh:property nias-ui:PddSectionAReportContentUiShape-hasSubject .

nias-ui:PddSectionAReportContentUiShape-isMadeBy a sh:PropertyShape ;
        sh:path claimont:isMadeBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAReportContentUiShape-hasSubject a sh:PropertyShape ;
        sh:path claimont:hasSubject ;
        sh:node nias-ui:ProjectDesignUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBReportContentUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionBReport ;
    sh:property nias-ui:PddSectionBReportContentUiShape-hasDeclaredImpact ;
    sh:property nias-ui:PddSectionBReportContentUiShape-impactClaim ;
    sh:property nias-ui:PddSectionBReportContentUiShape-usesMethodology .

nias-ui:PddSectionBReportContentUiShape-hasDeclaredImpact a sh:PropertyShape ;
        sh:path nias-o:hasDeclaredImpact ;
        sh:node nias-ui:ImpactRequirementUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionBReportContentUiShape-impactClaim a sh:PropertyShape ;
        sh:path nias-o:impactClaim ;
        sh:node nias-ui:ImpactClaimUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionBReportContentUiShape-usesMethodology a sh:PropertyShape ;
        sh:path nias-o:usesMethodology ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 99 .

nias-ui:PddSectionAUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property nias-ui:PddSectionAUiShape-reportContent .

nias-ui:PddSectionAUiShape-reportContent a sh:PropertyShape ;
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionAReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBUiShape a sh:NodeShape ;
    sh:targetClass data:Document ;
    sh:property nias-ui:PddSectionBUiShape-reportContent .

nias-ui:PddSectionBUiShape-reportContent a sh:PropertyShape ;
        sh:path nias-o:reportContent ;
        sh:node nias-ui:PddSectionBReportContentUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionCUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddSectionCStakeholderEngagement ;
    sh:property nias-ui:PddSectionCUiShape-stakeholderEngagementModalities ;
    sh:property nias-ui:PddSectionCUiShape-stakeholderCommentSummary ;
    sh:property nias-ui:PddSectionCUiShape-stakeholderCommentConsideration .

nias-ui:PddSectionCUiShape-stakeholderEngagementModalities a sh:PropertyShape ;
        sh:path nias-o:stakeholderEngagementModalities ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionCUiShape-stakeholderCommentSummary a sh:PropertyShape ;
        sh:path nias-o:stakeholderCommentSummary ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:PddSectionCUiShape-stakeholderCommentConsideration a sh:PropertyShape ;
        sh:path nias-o:stakeholderCommentConsideration ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:PddCertificateIssuanceRequestUiShape a sh:NodeShape ;
    sh:targetClass nias-o:PddCertificateIssuanceRequest ;
    sh:property nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionAValidationReview ;
    sh:property nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionBValidationReview ;
    sh:property nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionCValidationReview ;
    sh:property nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionQualitativeReview ;
    sh:property nias-ui:PddCertificateIssuanceRequestUiShape-pddDocumentLevelQualitativeReview ;
    sh:property nias-ui:PddCertificateIssuanceRequestUiShape-requestedIssuanceAccountId .

nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionAValidationReview a sh:PropertyShape ;
        sh:path nias-o:pddSectionAValidationReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionBValidationReview a sh:PropertyShape ;
        sh:path nias-o:pddSectionBValidationReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionCValidationReview a sh:PropertyShape ;
        sh:path nias-o:pddSectionCValidationReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddCertificateIssuanceRequestUiShape-pddSectionQualitativeReview a sh:PropertyShape ;
        sh:path nias-o:pddSectionQualitativeReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddCertificateIssuanceRequestUiShape-pddDocumentLevelQualitativeReview a sh:PropertyShape ;
        sh:path nias-o:pddDocumentLevelQualitativeReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddCertificateIssuanceRequestUiShape-requestedIssuanceAccountId a sh:PropertyShape ;
        sh:path nias-o:requestedIssuanceAccountId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ReviewTargetUiShape a sh:NodeShape ;
    sh:targetClass nias-o:ReviewTarget ;
    sh:property nias-ui:ReviewTargetUiShape-reviewedArtifact ;
    sh:property nias-ui:ReviewTargetUiShape-reviewedAnchor .

nias-ui:ReviewTargetUiShape-reviewedArtifact a sh:PropertyShape ;
        sh:path nias-o:reviewedArtifact ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ReviewTargetUiShape-reviewedAnchor a sh:PropertyShape ;
        sh:path nias-o:reviewedAnchor ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:DocumentFieldReview ;
    sh:property nias-ui:DocumentFieldReviewUiShape-fieldTitle ;
    sh:property nias-ui:DocumentFieldReviewUiShape-fieldPrompt ;
    sh:property nias-ui:DocumentFieldReviewUiShape-originalResponse ;
    sh:property nias-ui:DocumentFieldReviewUiShape-reviewerDecision ;
    sh:property nias-ui:DocumentFieldReviewUiShape-reviewerFeedback .

nias-ui:DocumentFieldReviewUiShape-fieldTitle a sh:PropertyShape ;
        sh:path nias-o:fieldTitle ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-fieldPrompt a sh:PropertyShape ;
        sh:path nias-o:fieldPrompt ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-originalResponse a sh:PropertyShape ;
        sh:path nias-o:originalResponse ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-reviewerDecision a sh:PropertyShape ;
        sh:path nias-o:reviewerDecision ;
        sh:in (
            nias-cs:review-reject
            nias-cs:review-corrective-action-request
            nias-cs:review-forward-action-request
            nias-cs:review-approve
        ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentFieldReviewUiShape-reviewerFeedback a sh:PropertyShape ;
        sh:path nias-o:reviewerFeedback ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionAValidationReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GenericDocumentReview ;
    sh:property nias-ui:PddSectionAValidationReviewUiShape-fieldReview ;
    sh:property nias-ui:PddSectionAValidationReviewUiShape-finalReviewDecision .

nias-ui:PddSectionAValidationReviewUiShape-fieldReview a sh:PropertyShape ;
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionAValidationReviewUiShape-finalReviewDecision a sh:PropertyShape ;
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionBValidationReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GenericDocumentReview ;
    sh:property nias-ui:PddSectionBValidationReviewUiShape-fieldReview ;
    sh:property nias-ui:PddSectionBValidationReviewUiShape-finalReviewDecision .

nias-ui:PddSectionBValidationReviewUiShape-fieldReview a sh:PropertyShape ;
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionBValidationReviewUiShape-finalReviewDecision a sh:PropertyShape ;
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:PddSectionCValidationReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GenericDocumentReview ;
    sh:property nias-ui:PddSectionCValidationReviewUiShape-fieldReview ;
    sh:property nias-ui:PddSectionCValidationReviewUiShape-finalReviewDecision .

nias-ui:PddSectionCValidationReviewUiShape-fieldReview a sh:PropertyShape ;
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:PddSectionCValidationReviewUiShape-finalReviewDecision a sh:PropertyShape ;
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:GlobalQualitativeDocumentReviewUiShape a sh:NodeShape ;
    sh:targetClass nias-o:GlobalQualitativeDocumentReview ;
    sh:property nias-ui:GlobalQualitativeDocumentReviewUiShape-hasWorkflowSubmission ;
    sh:property nias-ui:GlobalQualitativeDocumentReviewUiShape-isReviewOf ;
    sh:property nias-ui:GlobalQualitativeDocumentReviewUiShape-fieldReview ;
    sh:property nias-ui:GlobalQualitativeDocumentReviewUiShape-sectionQualitativeJudgement ;
    sh:property nias-ui:GlobalQualitativeDocumentReviewUiShape-documentLevelQualitativeJudgement ;
    sh:property nias-ui:GlobalQualitativeDocumentReviewUiShape-finalReviewDecision .

nias-ui:GlobalQualitativeDocumentReviewUiShape-hasWorkflowSubmission a sh:PropertyShape ;
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:GlobalQualitativeDocumentReviewUiShape-isReviewOf a sh:PropertyShape ;
        sh:path nias-o:isReviewOf ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:GlobalQualitativeDocumentReviewUiShape-fieldReview a sh:PropertyShape ;
        sh:path nias-o:fieldReview ;
        sh:node nias-ui:DocumentFieldReviewUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:GlobalQualitativeDocumentReviewUiShape-sectionQualitativeJudgement a sh:PropertyShape ;
        sh:path nias-o:sectionQualitativeJudgement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:GlobalQualitativeDocumentReviewUiShape-documentLevelQualitativeJudgement a sh:PropertyShape ;
        sh:path nias-o:documentLevelQualitativeJudgement ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:GlobalQualitativeDocumentReviewUiShape-finalReviewDecision a sh:PropertyShape ;
        sh:path nias-o:finalReviewDecision ;
        sh:in ( nias-cs:review-reject nias-cs:review-approve ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .
