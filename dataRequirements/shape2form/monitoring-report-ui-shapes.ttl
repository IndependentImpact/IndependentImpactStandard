@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2form/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2form.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:MonitoringReportUiShapes a owl:Ontology ;
    dcterms:title "NIAS monitoring report shape2form UI shapes"@en ;
    dcterms:description "UI-facing SHACL view for Monitoring Report capture. Canonical validation constraints remain in dataRequirements/monitoring-report-shapes.ttl."@en ;
    owl:imports nias-ui:CommonUiShapes .

nias-ui:IndicatorObservationUiShape a sh:NodeShape ;
    sh:targetClass ind:IndicatorObservation ;
    sh:property nias-ui:IndicatorObservationUiShape-observesIndicator ;
    sh:property nias-ui:IndicatorObservationUiShape-obsValue ;
    sh:property nias-ui:IndicatorObservationUiShape-hasUnit ;
    sh:property nias-ui:IndicatorObservationUiShape-timePeriod .

nias-ui:IndicatorObservationUiShape-observesIndicator a sh:PropertyShape ;
        sh:path ind:observesIndicator ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:IndicatorObservationUiShape-obsValue a sh:PropertyShape ;
        sh:path ind:obsValue ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:IndicatorObservationUiShape-hasUnit a sh:PropertyShape ;
        sh:path ind:hasUnit ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:IndicatorObservationUiShape-timePeriod a sh:PropertyShape ;
        sh:path ind:timePeriod ;
        sh:node nias-ui:DateTimeIntervalUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DatasetUiShape a sh:NodeShape ;
    sh:targetClass nias-o:Dataset ;
    sh:property nias-ui:DatasetUiShape-title ;
    sh:property nias-ui:DatasetUiShape-dataLineageReview ;
    sh:property nias-ui:DatasetUiShape-finalDatasetArtifact .

nias-ui:DatasetUiShape-title a sh:PropertyShape ;
        sh:path dcterms:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DatasetUiShape-dataLineageReview a sh:PropertyShape ;
        sh:path nias-o:dataLineageReview ;
        sh:node nias-ui:DocumentReferenceUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DatasetUiShape-finalDatasetArtifact a sh:PropertyShape ;
        sh:path nias-o:finalDatasetArtifact ;
        sh:node nias-ui:ResourceArtifactUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape a sh:NodeShape ;
    sh:targetClass nias-o:MonitoringReport ;
    sh:property nias-ui:MonitoringReportUiShape-hasWorkflowSubmission ;
    sh:property nias-ui:MonitoringReportUiShape-alignedWithPDD ;
    sh:property nias-ui:MonitoringReportUiShape-reportedIndicatorLabel ;
    sh:property nias-ui:MonitoringReportUiShape-forPeriod ;
    sh:property nias-ui:MonitoringReportUiShape-reportedObservation ;
    sh:property nias-ui:MonitoringReportUiShape-usesDataset ;
    sh:property nias-ui:MonitoringReportUiShape-calculationCode ;
    sh:property nias-ui:MonitoringReportUiShape-impactResultResource ;
    sh:property nias-ui:MonitoringReportUiShape-calculationReport ;
    sh:property nias-ui:MonitoringReportUiShape-requestedIssuanceAccountId .

nias-ui:MonitoringReportUiShape-hasWorkflowSubmission a sh:PropertyShape ;
        sh:path nias-o:hasWorkflowSubmission ;
        sh:node nias-ui:WorkflowDocumentSubmissionUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-alignedWithPDD a sh:PropertyShape ;
        sh:path nias-o:alignedWithPDD ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-reportedIndicatorLabel a sh:PropertyShape ;
        sh:path nias-o:reportedIndicatorLabel ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-forPeriod a sh:PropertyShape ;
        sh:path nias-o:forPeriod ;
        sh:node nias-ui:DateTimeIntervalUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-reportedObservation a sh:PropertyShape ;
        sh:path nias-o:reportedObservation ;
        sh:node nias-ui:IndicatorObservationUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-usesDataset a sh:PropertyShape ;
        sh:path nias-o:usesDataset ;
        sh:node nias-ui:DatasetUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:MonitoringReportUiShape-calculationCode a sh:PropertyShape ;
        sh:path nias-o:calculationCode ;
        sh:node nias-ui:ResourceArtifactUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-impactResultResource a sh:PropertyShape ;
        sh:path nias-o:impactResultResource ;
        sh:node nias-ui:ResourceArtifactUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-calculationReport a sh:PropertyShape ;
        sh:path nias-o:calculationReport ;
        sh:node nias-ui:ResourceArtifactUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:MonitoringReportUiShape-requestedIssuanceAccountId a sh:PropertyShape ;
        sh:path nias-o:requestedIssuanceAccountId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .
