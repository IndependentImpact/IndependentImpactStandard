@prefix aiao: <http://w3id.org/aiao#> .
@prefix claimont: <http://w3id.org/claimont#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hedera: <https://hashgraphontology.xyz/core/> .
@prefix impactont: <http://w3id.org/impactont#> .
@prefix ind: <http://independentimpact.org/indicator-owl/> .
@prefix nias-cs: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-o: <https://nova.org.za/novaimpactaccountingstandard/> .
@prefix nias-ui: <https://nova.org.za/novaimpactaccountingstandard/shape2form/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix ui: <https://shape2form.dev/vocab/ui#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nias-ui:CommonUiShapes a owl:Ontology ;
    dcterms:title "NIAS Common shape2form UI shapes"@en ;
    dcterms:description "Shared UI-facing SHACL shapes that are identical across two or more NIAS workflow bundles (PDD Design, PDD Workflow, Monitoring Report, Validation Report, Verification Report). Canonical validation constraints remain in dataRequirements/*.ttl."@en .

# ---------------------------------------------------------------------------
# Temporal shapes (all five workflow bundles)
# ---------------------------------------------------------------------------

nias-ui:TimeInstantUiShape a sh:NodeShape ;
    sh:targetClass time:Instant ;
    sh:property nias-ui:TimeInstantUiShape-inXSDDateTimeStamp .

nias-ui:TimeInstantUiShape-inXSDDateTimeStamp a sh:PropertyShape ;
        sh:path time:inXSDDateTimeStamp ;
        sh:datatype xsd:dateTimeStamp ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DateTimeIntervalUiShape a sh:NodeShape ;
    sh:targetClass time:Interval ;
    sh:property nias-ui:DateTimeIntervalUiShape-hasBeginning ;
    sh:property nias-ui:DateTimeIntervalUiShape-hasEnd .

nias-ui:DateTimeIntervalUiShape-hasBeginning a sh:PropertyShape ;
        sh:path time:hasBeginning ;
        sh:node nias-ui:TimeInstantUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DateTimeIntervalUiShape-hasEnd a sh:PropertyShape ;
        sh:path time:hasEnd ;
        sh:node nias-ui:TimeInstantUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

# ---------------------------------------------------------------------------
# Hedera consensus shapes (all five workflow bundles)
# ---------------------------------------------------------------------------

nias-ui:HederaTopicMessageUiShape a sh:NodeShape ;
    sh:targetClass hedera:TopicMessage ;
    sh:property nias-ui:HederaTopicMessageUiShape-inTopic ;
    sh:property nias-ui:HederaTopicMessageUiShape-hasSequenceNumber ;
    sh:property nias-ui:HederaTopicMessageUiShape-hasConsensusTimestamp ;
    sh:property nias-ui:HederaTopicMessageUiShape-hasMessageContent .

nias-ui:HederaTopicMessageUiShape-inTopic a sh:PropertyShape ;
        sh:path hedera:inTopic ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:HederaTopicMessageUiShape-hasSequenceNumber a sh:PropertyShape ;
        sh:path hedera:hasSequenceNumber ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 .

nias-ui:HederaTopicMessageUiShape-hasConsensusTimestamp a sh:PropertyShape ;
        sh:path hedera:hasConsensusTimestamp ;
        sh:datatype xsd:dateTimeStamp ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:HederaTopicMessageUiShape-hasMessageContent a sh:PropertyShape ;
        sh:path hedera:hasMessageContent ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape a sh:NodeShape ;
    sh:targetClass nias-o:WorkflowDocumentSubmission ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-submittedDocument ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-workflow ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-workflowStep ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-workflowSubject ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-workflowDocumentSubmittedBy ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-workflowDocumentRecipient ;
    sh:property nias-ui:WorkflowDocumentSubmissionUiShape-workflowSubmissionConsensusMessage .

nias-ui:WorkflowDocumentSubmissionUiShape-submittedDocument a sh:PropertyShape ;
        sh:path nias-o:submittedDocument ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape-workflow a sh:PropertyShape ;
        sh:path nias-o:workflow ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape-workflowStep a sh:PropertyShape ;
        sh:path nias-o:workflowStep ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape-workflowSubject a sh:PropertyShape ;
        sh:path nias-o:workflowSubject ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape-workflowDocumentSubmittedBy a sh:PropertyShape ;
        sh:path nias-o:workflowDocumentSubmittedBy ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape-workflowDocumentRecipient a sh:PropertyShape ;
        sh:path nias-o:workflowDocumentRecipient ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:WorkflowDocumentSubmissionUiShape-workflowSubmissionConsensusMessage a sh:PropertyShape ;
        sh:path nias-o:workflowSubmissionConsensusMessage ;
        sh:node nias-ui:HederaTopicMessageUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

# ---------------------------------------------------------------------------
# Document reference / resource artifact shapes
# (monitoring, pdd-workflow, validation, verification bundles)
# ---------------------------------------------------------------------------

nias-ui:DocumentReferenceUiShape a sh:NodeShape ;
    sh:targetClass nias-o:DocumentReference ;
    sh:property nias-ui:DocumentReferenceUiShape-documentMessageId ;
    sh:property nias-ui:DocumentReferenceUiShape-resourceIpfsUri .

nias-ui:DocumentReferenceUiShape-documentMessageId a sh:PropertyShape ;
        sh:path nias-o:documentMessageId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DocumentReferenceUiShape-resourceIpfsUri a sh:PropertyShape ;
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ResourceArtifactUiShape a sh:NodeShape ;
    sh:targetClass nias-o:ResourceArtifact ;
    sh:property nias-ui:ResourceArtifactUiShape-resourceIpfsUri .

nias-ui:ResourceArtifactUiShape-resourceIpfsUri a sh:PropertyShape ;
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

# ---------------------------------------------------------------------------
# PDD project-design shapes (pdd-design and pdd-workflow bundles)
# ---------------------------------------------------------------------------

nias-ui:ObjectiveUiShape a sh:NodeShape ;
    sh:targetClass aiao:Objective ;
    sh:property nias-ui:ObjectiveUiShape-description .

nias-ui:ObjectiveUiShape-description a sh:PropertyShape ;
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:SpatialLocationUiShape a sh:NodeShape ;
    sh:targetClass impactont:SpatialLocation ;
    sh:property nias-ui:SpatialLocationUiShape-resourceIpfsUri .

nias-ui:SpatialLocationUiShape-resourceIpfsUri a sh:PropertyShape ;
        sh:path nias-o:resourceIpfsUri ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:TechnologyOrMeasureUiShape a sh:NodeShape ;
    sh:targetClass nias-o:TechnologyOrMeasure ;
    sh:property nias-ui:TechnologyOrMeasureUiShape-techMeasType ;
    sh:property nias-ui:TechnologyOrMeasureUiShape-description ;
    sh:property nias-ui:TechnologyOrMeasureUiShape-currentAgeInYears ;
    sh:property nias-ui:TechnologyOrMeasureUiShape-estimatedLifespanInYears ;
    sh:property nias-ui:TechnologyOrMeasureUiShape-additionalInfo .

nias-ui:TechnologyOrMeasureUiShape-techMeasType a sh:PropertyShape ;
        sh:path nias-o:techMeasType ;
        sh:in ( nias-cs:facility nias-cs:system nias-cs:equipment nias-cs:other ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:TechnologyOrMeasureUiShape-description a sh:PropertyShape ;
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:TechnologyOrMeasureUiShape-currentAgeInYears a sh:PropertyShape ;
        sh:path nias-o:currentAgeInYears ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 .

nias-ui:TechnologyOrMeasureUiShape-estimatedLifespanInYears a sh:PropertyShape ;
        sh:path nias-o:estimatedLifespanInYears ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0 .

nias-ui:TechnologyOrMeasureUiShape-additionalInfo a sh:PropertyShape ;
        sh:path nias-o:additionalInfo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:ProjectPartyUiShape a sh:NodeShape ;
    sh:targetClass nias-o:ProjectParty ;
    sh:property nias-ui:ProjectPartyUiShape-partyName ;
    sh:property nias-ui:ProjectPartyUiShape-isHostParty ;
    sh:property nias-ui:ProjectPartyUiShape-isParticipantParty ;
    sh:property nias-ui:ProjectPartyUiShape-publicPrivateClassification ;
    sh:property nias-ui:ProjectPartyUiShape-additionalInfo .

nias-ui:ProjectPartyUiShape-partyName a sh:PropertyShape ;
        sh:path nias-o:partyName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectPartyUiShape-isHostParty a sh:PropertyShape ;
        sh:path nias-o:isHostParty ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectPartyUiShape-isParticipantParty a sh:PropertyShape ;
        sh:path nias-o:isParticipantParty ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectPartyUiShape-publicPrivateClassification a sh:PropertyShape ;
        sh:path nias-o:publicPrivateClassification ;
        sh:in ( nias-cs:public nias-cs:private ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectPartyUiShape-additionalInfo a sh:PropertyShape ;
        sh:path nias-o:additionalInfo ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape a sh:NodeShape ;
    sh:targetClass aiao:Project ;
    sh:property nias-ui:ProjectDesignUiShape-title ;
    sh:property nias-ui:ProjectDesignUiShape-hasObjective ;
    sh:property nias-ui:ProjectDesignUiShape-hasSpatialLocation ;
    sh:property nias-ui:ProjectDesignUiShape-technologyOrMeasure ;
    sh:property nias-ui:ProjectDesignUiShape-projectParty ;
    sh:property nias-ui:ProjectDesignUiShape-legalMatters ;
    sh:property nias-ui:ProjectDesignUiShape-publicFundingStatus ;
    sh:property nias-ui:ProjectDesignUiShape-publicFundingSource ;
    sh:property nias-ui:ProjectDesignUiShape-projectHistory ;
    sh:property nias-ui:ProjectDesignUiShape-debundlingAssessment ;
    sh:property nias-ui:ProjectDesignUiShape-eligibilityDescription .

nias-ui:ProjectDesignUiShape-title a sh:PropertyShape ;
        sh:path nias-o:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape-hasObjective a sh:PropertyShape ;
        sh:path aiao:hasObjective ;
        sh:node nias-ui:ObjectiveUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape-hasSpatialLocation a sh:PropertyShape ;
        sh:path impactont:hasSpatialLocation ;
        sh:node nias-ui:SpatialLocationUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:ProjectDesignUiShape-technologyOrMeasure a sh:PropertyShape ;
        sh:path nias-o:technologyOrMeasure ;
        sh:node nias-ui:TechnologyOrMeasureUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:ProjectDesignUiShape-projectParty a sh:PropertyShape ;
        sh:path nias-o:projectParty ;
        sh:node nias-ui:ProjectPartyUiShape ;
        sh:minCount 1 ;
        sh:maxCount 99 .

nias-ui:ProjectDesignUiShape-legalMatters a sh:PropertyShape ;
        sh:path nias-o:legalMatters ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape-publicFundingStatus a sh:PropertyShape ;
        sh:path nias-o:publicFundingStatus ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape-publicFundingSource a sh:PropertyShape ;
        sh:path nias-o:publicFundingSource ;
        sh:datatype xsd:string ;
        sh:maxCount 99 .

nias-ui:ProjectDesignUiShape-projectHistory a sh:PropertyShape ;
        sh:path nias-o:projectHistory ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape-debundlingAssessment a sh:PropertyShape ;
        sh:path nias-o:debundlingAssessment ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ProjectDesignUiShape-eligibilityDescription a sh:PropertyShape ;
        sh:path nias-o:eligibilityDescription ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:CreditingPeriodUiShape a sh:NodeShape ;
    sh:targetClass nias-o:CreditingPeriod ;
    sh:property nias-ui:CreditingPeriodUiShape-hasBeginning ;
    sh:property nias-ui:CreditingPeriodUiShape-hasEnd ;
    sh:property nias-ui:CreditingPeriodUiShape-creditingPeriodIsRenewable .

nias-ui:CreditingPeriodUiShape-hasBeginning a sh:PropertyShape ;
        sh:path time:hasBeginning ;
        sh:node nias-ui:TimeInstantUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:CreditingPeriodUiShape-hasEnd a sh:PropertyShape ;
        sh:path time:hasEnd ;
        sh:node nias-ui:TimeInstantUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:CreditingPeriodUiShape-creditingPeriodIsRenewable a sh:PropertyShape ;
        sh:path nias-o:creditingPeriodIsRenewable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape a sh:NodeShape ;
    sh:targetClass nias-o:DataParameterRequirement ;
    sh:property nias-ui:DataParameterRequirementUiShape-label ;
    sh:property nias-ui:DataParameterRequirementUiShape-description ;
    sh:property nias-ui:DataParameterRequirementUiShape-dataParameterPurpose ;
    sh:property nias-ui:DataParameterRequirementUiShape-hasUnit ;
    sh:property nias-ui:DataParameterRequirementUiShape-monitoredOrFixed ;
    sh:property nias-ui:DataParameterRequirementUiShape-measurementMethodsAndProcedures ;
    sh:property nias-ui:DataParameterRequirementUiShape-qaQcProcedures ;
    sh:property nias-ui:DataParameterRequirementUiShape-monitoringFrequency ;
    sh:property nias-ui:DataParameterRequirementUiShape-samplingPlan ;
    sh:property nias-ui:DataParameterRequirementUiShape-parameterAppliedValue ;
    sh:property nias-ui:DataParameterRequirementUiShape-dataSource .

nias-ui:DataParameterRequirementUiShape-label a sh:PropertyShape ;
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-description a sh:PropertyShape ;
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-dataParameterPurpose a sh:PropertyShape ;
        sh:path nias-o:dataParameterPurpose ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-hasUnit a sh:PropertyShape ;
        sh:path ind:hasUnit ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-monitoredOrFixed a sh:PropertyShape ;
        sh:path nias-o:monitoredOrFixed ;
        sh:in ( nias-cs:monitored nias-cs:fixed-ex-ante ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-measurementMethodsAndProcedures a sh:PropertyShape ;
        sh:path nias-o:measurementMethodsAndProcedures ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-qaQcProcedures a sh:PropertyShape ;
        sh:path nias-o:qaQcProcedures ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-monitoringFrequency a sh:PropertyShape ;
        sh:path nias-o:monitoringFrequency ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-samplingPlan a sh:PropertyShape ;
        sh:path nias-o:samplingPlan ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-parameterAppliedValue a sh:PropertyShape ;
        sh:path nias-o:parameterAppliedValue ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 .

nias-ui:DataParameterRequirementUiShape-dataSource a sh:PropertyShape ;
        sh:path nias-o:dataSource ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:IndicatorValueUiShape a sh:NodeShape ;
    sh:targetClass impactont:IndicatorValue ;
    sh:property nias-ui:IndicatorValueUiShape-value ;
    sh:property nias-ui:IndicatorValueUiShape-hasUnit .

nias-ui:IndicatorValueUiShape-value a sh:PropertyShape ;
        sh:path rdf:value ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:IndicatorValueUiShape-hasUnit a sh:PropertyShape ;
        sh:path ind:hasUnit ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 .

nias-ui:StateWithIndicatorValueUiShape a sh:NodeShape ;
    sh:targetClass impactont:State ;
    sh:property nias-ui:StateWithIndicatorValueUiShape-hasTemporalLocation ;
    sh:property nias-ui:StateWithIndicatorValueUiShape-hasModality ;
    sh:property nias-ui:StateWithIndicatorValueUiShape-isDefinedByIndicator ;
    sh:property nias-ui:StateWithIndicatorValueUiShape-hasIndicatorValue .

nias-ui:StateWithIndicatorValueUiShape-hasTemporalLocation a sh:PropertyShape ;
        sh:path impactont:hasTemporalLocation ;
        sh:node nias-ui:TimeInstantUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:StateWithIndicatorValueUiShape-hasModality a sh:PropertyShape ;
        sh:path impactont:hasModality ;
        sh:in ( "counterfactual" "real" ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:StateWithIndicatorValueUiShape-isDefinedByIndicator a sh:PropertyShape ;
        sh:path impactont:isDefinedByIndicator ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:StateWithIndicatorValueUiShape-hasIndicatorValue a sh:PropertyShape ;
        sh:path impactont:hasIndicatorValue ;
        sh:node nias-ui:IndicatorValueUiShape ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape a sh:NodeShape ;
    sh:targetClass impactont:Impact ;
    sh:property nias-ui:ImpactRequirementUiShape-impactIntentionality ;
    sh:property nias-ui:ImpactRequirementUiShape-beneficialOrAdverse ;
    sh:property nias-ui:ImpactRequirementUiShape-description ;
    sh:property nias-ui:ImpactRequirementUiShape-monitored ;
    sh:property nias-ui:ImpactRequirementUiShape-notMonitoredJustification ;
    sh:property nias-ui:ImpactRequirementUiShape-additionalityJustification ;
    sh:property nias-ui:ImpactRequirementUiShape-hasStateA ;
    sh:property nias-ui:ImpactRequirementUiShape-hasStateB ;
    sh:property nias-ui:ImpactRequirementUiShape-hasProvenance ;
    sh:property nias-ui:ImpactRequirementUiShape-creditingPeriod ;
    sh:property nias-ui:ImpactRequirementUiShape-monitoringPeriod ;
    sh:property nias-ui:ImpactRequirementUiShape-dataParameterRequirement ;
    sh:property nias-ui:ImpactRequirementUiShape-exAnteImpactEstimate .

nias-ui:ImpactRequirementUiShape-impactIntentionality a sh:PropertyShape ;
        sh:path nias-o:impactIntentionality ;
        sh:in ( nias-cs:intentional nias-cs:unintentional ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-beneficialOrAdverse a sh:PropertyShape ;
        sh:path nias-o:beneficialOrAdverse ;
        sh:in ( nias-cs:beneficial nias-cs:adverse ) ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-description a sh:PropertyShape ;
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-monitored a sh:PropertyShape ;
        sh:path nias-o:monitored ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-notMonitoredJustification a sh:PropertyShape ;
        sh:path nias-o:notMonitoredJustification ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-additionalityJustification a sh:PropertyShape ;
        sh:path nias-o:additionalityJustification ;
        sh:datatype xsd:string ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-hasStateA a sh:PropertyShape ;
        sh:path impactont:hasStateA ;
        sh:node nias-ui:StateWithIndicatorValueUiShape ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-hasStateB a sh:PropertyShape ;
        sh:path impactont:hasStateB ;
        sh:node nias-ui:StateWithIndicatorValueUiShape ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-hasProvenance a sh:PropertyShape ;
        sh:path impactont:hasProvenance ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 99 .

nias-ui:ImpactRequirementUiShape-creditingPeriod a sh:PropertyShape ;
        sh:path nias-o:creditingPeriod ;
        sh:node nias-ui:CreditingPeriodUiShape ;
        sh:maxCount 1 .

nias-ui:ImpactRequirementUiShape-monitoringPeriod a sh:PropertyShape ;
        sh:path nias-o:monitoringPeriod ;
        sh:node nias-ui:DateTimeIntervalUiShape ;
        sh:maxCount 99 .

nias-ui:ImpactRequirementUiShape-dataParameterRequirement a sh:PropertyShape ;
        sh:path nias-o:dataParameterRequirement ;
        sh:node nias-ui:DataParameterRequirementUiShape ;
        sh:maxCount 99 .

nias-ui:ImpactRequirementUiShape-exAnteImpactEstimate a sh:PropertyShape ;
        sh:path nias-o:exAnteImpactEstimate ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 .

nias-ui:ImpactClaimUiShape a sh:NodeShape ;
    sh:targetClass aiao:ImpactClaim ;
    sh:property nias-ui:ImpactClaimUiShape-hasSubject ;
    sh:property nias-ui:ImpactClaimUiShape-usesMethodology .

nias-ui:ImpactClaimUiShape-hasSubject a sh:PropertyShape ;
        sh:path claimont:hasSubject ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 1 .

nias-ui:ImpactClaimUiShape-usesMethodology a sh:PropertyShape ;
        sh:path nias-o:usesMethodology ;
        sh:datatype xsd:anyURI ;
        sh:minCount 1 ;
        sh:maxCount 99 .
